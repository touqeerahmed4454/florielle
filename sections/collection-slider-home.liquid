<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{%- if section.blocks.size > 0 -%}
<style>
    .slide-change{
    padding-bottom:80px; 
}

  .fl-section-header { padding-top:40px;margin-bottom: 30px; text-align: center; }
  .fl-section-header h2 
  { color: #000;
text-align: center;
font-size: 42px;
   font-family: var(--heading-font-family);
font-style: normal;
padding-bottom:20px;
font-weight: 600;
line-height: normal;
}
  .fl-section-header p { color: #333);
text-align: center;
font-size: 20px;
  font-family: var(--text-font-family);
font-style: normal;
font-weight: 400;
line-height: normal; }

  .swiper-container-{{ section.id }} { 
    position: relative; 
    padding: 20px 0 60px; 
    overflow: hidden;
  }
  .swiper-button-next, .swiper-button-prev {
    background: white;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    color: #000 !important;
    top:40%;
  }
  .swiper-button-next:after, .swiper-button-prev:after { font-size: 18px; font-weight: bold; }

  .view-all-wrapper { text-align: center; margin-top:0px; }
  .view-all-btn {
border-radius: 50px;
background: #EAA44B;
    padding: 14px 34px;
    text-decoration: none;
    display: inline-block;
    transition: 0.3s;
    color: #000;
font-size: 18px;
   font-family: var(--heading-font-family);
font-style: normal;
font-weight: 600;
line-height: normal;
border:1px  solid #EAA44B;
text-transform: uppercase;
  }
  .view-all-btn:hover { background-color: #d89548; opacity: 0.9; }

  @media screen and (max-width: 768px) {
    .fl-section-header h2 { font-size: 24px; }
    .swiper-button-next, .swiper-button-prev { display: none; } 
  }
</style>
{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="slide-change section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    
    <div class="fl-section-header">
       <h2>{{ section.blocks.first.settings.title | default: section.blocks.first.settings.collection.title }}</h2>
       {% if section.settings.subheading != blank %}
         <p>{{ section.settings.subheading }}</p>
       {% endif %}
    </div>

    <div class="swiper swiper-container-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- assign collection = section.blocks.first.settings.collection -%}
        {%- for product in collection.products limit: section.blocks.first.settings.products_count -%}
          <div class="swiper-slide">
            {%- render 'product-card', product: product -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>

    {%- if section.blocks.first.settings.link_text != blank -%}
      <div class="view-all-wrapper">
        <a href="{{ section.blocks.first.settings.link_url | default: collection.url }}" class="button view-all-btn">
          {{ section.blocks.first.settings.link_text | upcase }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.swiper-container-{{ section.id }}', {
      slidesPerView: 1.2, 
      spaceBetween: 15,
      centeredSlides: false,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      breakpoints: {
        768: { slidesPerView: 2.5, spaceBetween: 20 },
        1024: { slidesPerView: 4, spaceBetween: 20 }
      }
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Florielle Slider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most loved bouquets, chosen by customers."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 1,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "range",
          "id": "products_count",
          "min": 4,
          "max": 20,
          "label": "Products to show",
          "default": 8
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading Override"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "View All Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button Text",
          "default": "View All"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Florielle Slider",
      "blocks": [ { "type": "collection" } ]
    }
  ]
}
{% endschema %}